# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything real stays out
.env*

# ...except the template, which carries no secrets and is the only place a new
# contributor (or you, on a new machine) learns what configuration is required.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
