# Copy to .env.local and fill in. Never commit the filled-in version —
# .gitignore already covers .env*, keep it that way.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres. Neon and Supabase both have a free tier that's plenty for this.
# Use the POOLED connection string — serverless functions open a lot of
# short-lived connections and a direct one will exhaust the server.
DATABASE_URL="postgresql://user:password@host/studeo?sslmode=require"

# Unpooled/direct connection. Prisma migrations need this; the app doesn't.
DIRECT_URL="postgresql://user:password@host/studeo?sslmode=require"

# ---------------------------------------------------------------------------
# Credential vault
# ---------------------------------------------------------------------------
# Encrypts stored Academia session cookies (lib/vault.ts). 32 random bytes,
# base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this invalidates every stored session and forces all users to sign
# in again. That's a survivable outcome, not a data loss — which is rather the
# point of storing sessions instead of passwords.
VAULT_KEY=""

# Signs our own session cookie (separate concern from the vault above).
# Same generation command.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# The public demo runs entirely on seeded data — no real credentials ever touch
# it. This token gates the read-only demo API.
DEMO_TOKEN_SECRET=""

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Vercel signs its scheduled requests with this as `Authorization: Bearer …`.
# Used by /api/cron/keepalive, which exists to stop a free Supabase project
# pausing itself after a week of inactivity — a paused project doesn't wake on
# its own, and the failure mode is a dead demo on a link you sent weeks ago.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the claim URL the extension opens after a sync, so it must be
# the real deployed origin in production, not localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
